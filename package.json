{
  "name": "next-reel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "postinstall": "npm run model && nuxt prepare",
    "predev": "npm run model",
    "pretypecheck": "npm run model",
    "catalog": "node --env-file=.env --import tsx scripts/prepare-catalog.ts",
    "model": "tsx scripts/build-model.ts",
    "prebuild": "npm run model",
    "build": "nuxt build",
    "postbuild": "tsx scripts/check-public-build.ts",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evaluate": "tsx scripts/evaluate.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "preview": "wrangler pages dev .output/public",
    "deploy": "wrangler pages deploy .output/public --project-name next-reel"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "nuxt": "4.6.1"
  }
}
